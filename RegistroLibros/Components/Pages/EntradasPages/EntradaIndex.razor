@page "/Entrada/Index"

@inject EntradasService entradasService
@inject ToastService toastService

<PageTitle>Registro de Entradas</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-center mb-4">
            <h5 class="card-title">Registro de Entradas</h5>
            <a href="/Entrada/Create" class="btn btn-primary">
                <span class="bi bi-plus-square mt-3"></span> Crear
            </a>
        </div>

        <div class="card-body">
            @* Filtro *@
            <div class="row">
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por</strong></label>
                </div>
                <div class="col-4">
                    <label class="col-form-label"><strong>Búsqueda</strong></label>
                </div>
            </div>

            @* Controles de búsqueda *@
            <div class="row align-items-center">
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opci&oacute;n</option>
                        <option value="Fecha">Fecha</option>
                        <option value="Total">Cantidad total</option>
                    </InputSelect>
                </div>
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-3">
                    <label class="col-form-label"><strong>Desde</strong></label>
                    <InputDate class="form-control" @bind-Value="Desde"></InputDate>
                </div>
                <div class="col-3">
                    <label class="col-form-label"><strong>Hasta</strong></label>
                    <InputDate class="form-control" @bind-Value="Hasta"></InputDate>
                </div>
            </div>

            @* Tabla *@
            <div class="grid">
                <QuickGrid Items="ListaEntradas.AsQueryable()" Class="table table-hover mt-3">
                    <PropertyColumn Property="@(e => e.EntradaId)" Title="EntradaId" Sortable="true" Align="Align.Left" />
                    <PropertyColumn Property="@(e => e.Fecha)" Title="Fecha" Format="dd/MM/yyyy" Sortable="true" Align="Align.Left" />
                    <PropertyColumn Property="@(e => e.Concepto)" Title="Concepto" Sortable="true" Align="Align.Left" />
                    <PropertyColumn Property="@(e => e.Total)" Title="Cantidad total" Format="N0" Sortable="true" Align="Align.Left" />
                    <TemplateColumn Title="Opciones" Align="Align.Center">
                        <div class="d-flex text-nowrap">
                            <a href="/Entrada/Edit/@context.EntradaId" class="btn btn-outline-primary bi bi-pencil-square"></a>
                            <button type="button" class="btn btn-outline-danger bi bi-trash ms-2"
                                    data-bs-toggle="modal" data-bs-target="#modalEliminarEntrada"
                                    @onclick="() => entradaIdAEliminar = context.EntradaId"></button>
                        </div>
                    </TemplateColumn>
                </QuickGrid>
            </div>
        </div>

        <div class="card-footer d-flex justify-content-between align-center mb-4">
            <label class="ms-3"><strong>Cantidad:</strong> @ListaEntradas.Count</label>
            <div class="col-5 text-end pe-4">
                <label><strong>Total de libros:</strong> @ListaEntradas.Sum(e => e.Total).ToString("N0")</label>
            </div>
        </div>
    </div>
</div>

@* Modal de eliminación *@
<div class="modal fade" id="modalEliminarEntrada" tabindex="-1" aria-labelledby="modalEliminarEntradaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="modalEliminarEntradaLabel">Eliminar Entrada</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                ¿Estás seguro de que deseas eliminar esta entrada?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="Eliminar">Sí, eliminar</button>
            </div>
        </div>
    </div>
</div>

@code {
    public List<Entradas> ListaEntradas { get; set; } = new List<Entradas>();
    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;
    public DateTime? Desde { get; set; }
    public DateTime? Hasta { get; set; }
    private int entradaIdAEliminar;

    protected override async Task OnInitializedAsync()
    {
        await CargarEntradas();
        Desde = null;
        Hasta = null;
    }

    private async Task CargarEntradas()
    {
        var entradasResult = await entradasService.GetList(e => true);
        entradasResult.OnSuccess(entradas => ListaEntradas = entradas);
        entradasResult.OnFailure(() => toastService.ShowError("No se pudieron consultar las entradas."));
    }

    private async Task Eliminar()
    {
        var result = await entradasService.Eliminar(entradaIdAEliminar);
        result.OnSuccess(() => toastService.ShowSuccess("Entrada eliminada correctamente."));
        result.OnFailure(() => toastService.ShowError("No se pudo eliminar la entrada."));

        if (result.IsSuccess)
        {
            await CargarEntradas();
        }
    }

    private async Task Buscar()
    {
        if (Filtro == "Fecha")
        {
            var entradasPorFechaResult = await entradasService.GetList(e =>
                e.Fecha >= Desde && e.Fecha <= Hasta);
            entradasPorFechaResult.OnSuccess(entradas => ListaEntradas = entradas);
            entradasPorFechaResult.OnFailure(() =>
                toastService.ShowError("No se pudieron consultar las entradas."));
        }
        else if (Filtro == "Total")
        {
            var total = Convert.ToDecimal(ValorFiltro);
            var entradasPorTotalResult = await entradasService.GetList(e => e.Total == total);
            entradasPorTotalResult.OnSuccess(entradas => ListaEntradas = entradas);
            entradasPorTotalResult.OnFailure(() =>
                toastService.ShowError("No se pudieron consultar las entradas."));
        }
        else
        {
            toastService.ShowError("Seleccione un filtro.");
        }
    }

}
