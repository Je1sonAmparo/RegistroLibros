@page "/Estudiante/Index"

@inject EstudiantesService estudianteService
@inject ToastService toastService

<PageTitle>Registro de Estudiantes</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-center mb-4">
            <h5 class="card-title">Registro de Estudiantes</h5>
            <a href="/Estudiante/Create" class="btn btn-primary"> <span class="bi bi-plus-square mt-3"></span> Crear</a>
        </div>

        @* Filtro *@
        <div class="card-body">
            <div class="row">
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por</strong></label>
                </div>
                <div class="col-4">
                    <label class="col-form-label"><strong>B&uacute;squeda</strong></label>
                </div>
            </div>

            @* Controles de Busqueda *@
            <div class="row align-items-center">
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opci&oacute;n</option>
                        <option value="Nombres">Nombres</option>
                    </InputSelect>
                </div>
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>
            </div>

            @* Tabla *@
            <div class="grid">
                <QuickGrid Items="ListaEstudiantes.AsQueryable()" Class="table table-hover mt-3">
                    <PropertyColumn Property="@(e => e.EstudianteId)" Title="EstudianteId" Sortable="true" />
                    <PropertyColumn Property="@(e => e.Nombres)" Title="Nombres" Sortable="true" />
                    <PropertyColumn Property="@(e => e.Direccion)" Title="Dirección" Sortable="true" />
                    <PropertyColumn Property="@(e => e.Email)" Title="Email" Sortable="true" />
                    <PropertyColumn Property="@(e => e.FechaNacimiento)" Title="Fecha de Nacimiento" Format="dd/MM/yyyy" Sortable="true" />
                    <TemplateColumn Title="Opciones" Align="Align.Center">
                        <div class="d-flex text-nowrap">
                            <a href="/Estudiante/Edit/@context.EstudianteId" class="btn btn-outline-primary bi bi-pencil-square"></a>
                            <button type="button" class="btn btn-outline-danger bi bi-trash ms-2" data-bs-toggle="modal" data-bs-target="#modalEliminarEstudiante" @onclick="() => estudianteIdAEliminar = context.EstudianteId"></button>
                        </div>
                    </TemplateColumn>
                </QuickGrid>
            </div>
        </div>
        
        <div class="card-footer d-flex justify-content-between align-center mb-4">
            <label>Cantidad:  @ListaEstudiantes.Count()</label>
        </div>
    </div>
</div>

@* Modal de eliminación *@
<div class="modal fade" id="modalEliminarEstudiante" tabindex="-1" aria-labelledby="modalEliminarEstudianteLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="modalEliminarEstudianteLabel">Eliminar Estudiante</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        ¿Estás seguro de que deseas eliminar este estudiante?.
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="Eliminar">Sí, eliminar</button>
      </div>
    </div>
  </div>
</div>

@code {
    public List<Estudiantes> ListaEstudiantes { get; set; } = new List<Estudiantes>();
    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        ListaEstudiantes = await estudianteService.GetList(p => true);
    }

    private async Task Buscar()
    {
        if (ValorFiltro.Trim() != "")
        {
            if (Filtro == "Nombres")
            {
                ListaEstudiantes = await estudianteService.GetList(p => p.Nombres!.ToLower().Contains(ValorFiltro.ToLower()));
            }
        }
        else
            ListaEstudiantes = await estudianteService.GetList(p => true);
    }

    private int estudianteIdAEliminar;

    private async Task Eliminar()
    {
        var eliminado = await estudianteService.Eliminar(estudianteIdAEliminar);
        if (eliminado)
        {
            toastService.ShowSuccess("Estudiante eliminado correctamente.");
            await Buscar();
        }
        else
        {
            toastService.ShowError("No se pudo eliminar el estudiante.");
        }
    }
}
