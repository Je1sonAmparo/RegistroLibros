@page "/Estudiante/Edit/{EstudianteId:int}"
@inject EstudiantesServices estudianteService
@inject NavigationManager navigationManager

<PageTitle>Modificar Estudiante</PageTitle>

<EditForm Model="Estudiante" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Modificar Estudiante</h5>
            </div>

            @* Nombres *@
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label"><strong>Nombres</strong></label>
                    <InputText class="form-control" @bind-Value="Estudiante.Nombres"></InputText>
                    <ValidationMessage For="(() => Estudiante.Nombres)" />
                </div>

                @* Dirección *@
                <div class="mb-3">
                    <label class="form-label"><strong>Dirección</strong></label>
                    <InputText class="form-control" @bind-Value="Estudiante.Direccion"></InputText>
                    <ValidationMessage For="(() => Estudiante.Direccion)" />
                </div>

                @* Email *@
                <div class="mb-3">
                    <label class="form-label"><strong>Email</strong></label>
                    <InputText class="form-control" @bind-Value="Estudiante.Email"></InputText>
                    <ValidationMessage For="(() => Estudiante.Email)" />
                </div>

                @* Fecha de Nacimiento *@
                <div class="mb-3">
                    <label class="form-label"><strong>Fecha de Nacimiento</strong></label>
                    <InputDate class="form-control" @bind-Value="Estudiante.FechaNacimiento"></InputDate>
                    <ValidationMessage For="(() => Estudiante.FechaNacimiento)" />
                </div>
            </div>

            @* Botones de Acción *@
            <div class="card-footer text-center mt-2">
                <a href="/Estudiante/Index" class="btn btn-secondary">
                    <span class="bi bi-arrow-left"></span> Volver
                </a>
                <button type="submit" class="btn btn-primary bi bi-floppy"> Modificar</button>
                <a href="/Estudiante/Delete/@Estudiante.EstudianteId" class="btn btn-danger bi bi-trash"> Eliminar</a>
            </div>
        </div>
    </div>
</EditForm>

@code {
    [Parameter]
    public int EstudianteId { get; set; }

    public Estudiantes Estudiante { get; set; } = new Estudiantes();

    protected override async Task OnInitializedAsync()
    {
        Estudiante = await estudianteService.Buscar(EstudianteId);
    }

    public async Task Modificar()
    {
        Estudiante.Nombres = Estudiante.Nombres?.Trim();

        var nombreExiste = await estudianteService.GetList(e => e.Nombres!.ToLower() == Estudiante.Nombres!.ToLower() && e.EstudianteId != Estudiante.EstudianteId);

        if (nombreExiste.Any())
        {
            toastService.ShowError("Ya existe otro estudiante registrado con este nombre.");
            return;
        }

        var modificado = await estudianteService.Guardar(Estudiante);

        if (modificado)
        {
            toastService.ShowSuccess("Se ha modificado correctamente.");
            navigationManager.NavigateTo("/Estudiante/Index");
        }
        else
        {
            toastService.ShowError("No se ha podido modificar correctamente.");
        }
    }
}