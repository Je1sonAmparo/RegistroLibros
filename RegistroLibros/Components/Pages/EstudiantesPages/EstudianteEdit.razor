@page "/Estudiante/Edit/{EstudianteId:int}"

@inject EstudiantesService estudianteService
@inject PrestamosService prestamosService
@inject NavigationManager navigationManager
@inject ToastService toastService

<PageTitle>Modificar Estudiante</PageTitle>
<EditForm Model="Estudiante" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Modificar Estudiante</h5>
            </div>

            @* Nombres *@
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label"><strong>Nombres</strong></label>
                    <InputText class="form-control" @bind-Value="Estudiante.Nombres"></InputText>
                    <ValidationMessage For="(() => Estudiante.Nombres)" />
                </div>

                @* Dirección *@
                <div class="mb-3">
                    <label class="form-label"><strong>Dirección</strong></label>
                    <InputText class="form-control" @bind-Value="Estudiante.Direccion"></InputText>
                    <ValidationMessage For="(() => Estudiante.Direccion)" />
                </div>

                @* Email *@
                <div class="mb-3">
                    <label class="form-label"><strong>Email</strong></label>
                    <InputText class="form-control" @bind-Value="Estudiante.Email"></InputText>
                    <ValidationMessage For="(() => Estudiante.Email)" />
                </div>

                @* Fecha de Nacimiento *@
                <div class="mb-3">
                    <label class="form-label"><strong>Fecha de Nacimiento</strong></label>
                    <InputDate class="form-control" @bind-Value="Estudiante.FechaNacimiento"></InputDate>
                    <ValidationMessage For="(() => Estudiante.FechaNacimiento)" />
                </div>
            </div>

            @* Botones de Acción *@
            <div class="card-footer text-center mt-2">
                <a href="/Estudiante/Index" class="btn btn-secondary">
                    <span class="bi bi-arrow-left"></span> Volver
                </a>
                <button type="submit" class="btn btn-primary bi bi-floppy"> Modificar</button>
                <button type="button" class="btn btn-danger bi bi-trash" data-bs-toggle="modal" data-bs-target="#modalEliminarEstudiante"> Eliminar</button>
            </div>
        </div>
    </div>
</EditForm>

@* Modal de eliminación *@
<div class="modal fade" id="modalEliminarEstudiante" tabindex="-1" aria-labelledby="modalEliminarEstudianteLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="modalEliminarEstudianteLabel">Eliminar Estudiante</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        ¿Estás seguro de que deseas eliminar este estudiante?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="Eliminar">Sí, eliminar</button>
      </div>
    </div>
  </div>
</div>

@code {
    [Parameter]
    public int EstudianteId { get; set; }

    public Estudiantes Estudiante { get; set; } = new Estudiantes();

    protected override async Task OnInitializedAsync()
    {
        var result = await estudianteService.Buscar(EstudianteId);
        result.OnSuccess(estudiante => Estudiante = estudiante ?? new Estudiantes());
    }

    public async Task Modificar()
    {
        Estudiante.Nombres = Estudiante.Nombres?.Trim();

        var nombreExisteResult = await estudianteService.GetList(e => e.Nombres!.ToLower() == Estudiante.Nombres!.ToLower() && e.EstudianteId != Estudiante.EstudianteId);
        var nombreExiste = false;
        nombreExisteResult.OnSuccess(estudiantes => nombreExiste = estudiantes.Any());

        if (nombreExisteResult.IsFailure)
        {
            toastService.ShowError("No se pudo validar el nombre del estudiante.");
            return;
        }

        if (nombreExiste)
        {
            toastService.ShowError("Ya existe otro estudiante registrado con este nombre.");
            return;
        }

        var result = await estudianteService.Guardar(Estudiante);
        result.OnSuccess(() =>
        {
            toastService.ShowSuccess("Se ha modificado correctamente.");
            navigationManager.NavigateTo("/Estudiante/Index");
        });
        result.OnFailure(() => toastService.ShowError("No se ha podido modificar"));
    }

    private async Task Eliminar()
    {
        var prestamosResult = await prestamosService.GetList(p => p.EstudianteId == EstudianteId);
        var tienePrestamos = false;
        prestamosResult.OnSuccess(prestamos => tienePrestamos = prestamos.Any());
        if (prestamosResult.IsFailure)
        {
            toastService.ShowError("No se pudieron consultar los préstamos del estudiante.");
            return;
        }

        if (tienePrestamos)
        {
            toastService.ShowError("No se puede eliminar el estudiante porque tiene préstamos registrados.");
            return;
        }

        var result = await estudianteService.Eliminar(EstudianteId);
        result.OnSuccess(() =>
        {
            toastService.ShowSuccess("Estudiante eliminado correctamente.");
            navigationManager.NavigateTo("/Estudiante/Index");
        });
        result.OnFailure(() => toastService.ShowError("No se pudo eliminar correctamente"));
    }
}
