@page "/Libro/Index"

@inject LibrosService librosService
@inject PrestamosService prestamosService
@inject DevolucionesService devolucionesService
@inject ToastService toastService

<PageTitle>Registro de Libros</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-center mb-4">
            <h5 class="card-title">Registro de Libros</h5>
            <a href="/Libro/Create" class="btn btn-primary"> <span class="bi bi-plus-square mt-3"></span> Crear</a>
        </div>
        
        @* Filtro *@
        <div class="card-body">
            <div class="row">
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por</strong></label>
                </div>
                <div class="col-4">
                    <label class="col-form-label"><strong>B&uacute;squeda</strong></label>
                </div>
            </div>

            @* Controles de Busqueda *@
            <div class="row align-items-center">
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opci&oacute;n</option>
                        <option value="Titulo">Título</option>
                        <option value="Autor">Autor</option>
                    </InputSelect>
                </div>
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>
            </div>

            @* Tabla *@
            <div class="grid">
                <QuickGrid Items="ListaLibros.AsQueryable()" Class="table table-hover mt-3">
                    <PropertyColumn Property="@(l => l.LibroId)" Title="LibroId" Sortable="true" />
                    <PropertyColumn Property="@(l => l.Titulo)" Title="Título" Sortable="true" />
                    <PropertyColumn Property="@(l => l.Autor)" Title="Autor" Sortable="true" />
                    <PropertyColumn Property="@(l => l.AnoPublicacion)" Title="Año de Publicación" Sortable="true" />
                    <TemplateColumn Title="Promedio de días prestado">
                        @ObtenerPromedioDiasPrestado(context.LibroId).ToString("N2")
                    </TemplateColumn>
                    <TemplateColumn Title="Opciones" Align="Align.Center">
                        <div class="d-flex text-nowrap">
                            <a href="/Libro/Edit/@context.LibroId" class="btn btn-outline-primary bi bi-pencil-square"></a>
                            <button type="button" class="btn btn-outline-danger bi bi-trash ms-2" data-bs-toggle="modal" data-bs-target="#modalEliminarLibro" @onclick="() => libroIdAEliminar = context.LibroId"></button>
                        </div>
                    </TemplateColumn>
                </QuickGrid>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-between align-center mb-4">
            <label>Cantidad:  @ListaLibros.Count()</label>
        </div>
    </div>
</div>

@* Modal de eliminación *@
<div class="modal fade" id="modalEliminarLibro" tabindex="-1" aria-labelledby="modalEliminarLibroLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="modalEliminarLibroLabel">Eliminar Libro</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        ¿Estás seguro de que deseas eliminar este libro?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="Eliminar">Sí, eliminar</button>
      </div>
    </div>
  </div>
</div>

@code {
    public List<Libros> ListaLibros { get; set; } = new List<Libros>();
    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;
    private List<Devoluciones> ListaDevoluciones { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        var librosResult = await librosService.GetList(p => true);
        librosResult.OnSuccess(libros => ListaLibros = libros);

        var devolucionesResult = await devolucionesService.GetList(d => true);
        devolucionesResult.OnSuccess(devoluciones => ListaDevoluciones = devoluciones);
    }

    private double ObtenerPromedioDiasPrestado(int libroId)
    {
        return ListaDevoluciones
            .Where(d => d.Prestamo != null && d.Prestamo.LibroId == libroId)
            .Select(d => (d.FechaDevolucion - d.Prestamo!.FechaPrestamo).Days)
            .DefaultIfEmpty(0)
            .Average();
    }

    private async Task Buscar()
    {
        if (ValorFiltro.Trim() != "")
        {
            if (Filtro == "Titulo")
            {
                var librosResult = await librosService.GetList(p => p.Titulo!.ToLower().Contains(ValorFiltro.ToLower()));
                librosResult.OnSuccess(libros => ListaLibros = libros);
            }
            else if (Filtro == "Autor")
            {
                var librosResult = await librosService.GetList(p => p.Autor!.ToLower().Contains(ValorFiltro.ToLower()));
                librosResult.OnSuccess(libros => ListaLibros = libros);
            }
        }
        else
        {
            var librosResult = await librosService.GetList(p => true);
            librosResult.OnSuccess(libros => ListaLibros = libros);
        }

        var devolucionesResult = await devolucionesService.GetList(d => true);
        devolucionesResult.OnSuccess(devoluciones => ListaDevoluciones = devoluciones);
    }

    private int libroIdAEliminar;

    private async Task Eliminar()
    {
        var prestamosActivosResult = await prestamosService.GetList(p =>
            p.LibroId == libroIdAEliminar && !p.Devuelto);
        var tienePrestamosActivos = false;
        prestamosActivosResult.OnSuccess(prestamos => tienePrestamosActivos = prestamos.Any());
        if (prestamosActivosResult.IsFailure)
        {
            toastService.ShowError("No se pudieron consultar los préstamos activos del libro.");
            return;
        }

        if (tienePrestamosActivos)
        {
            toastService.ShowError("No se puede eliminar el libro porque está prestado actualmente.");
            return;
        }

        var result = await librosService.Eliminar(libroIdAEliminar);
        result.OnSuccess(() => toastService.ShowSuccess("Libro eliminado correctamente."));
        result.OnFailure(() => toastService.ShowError("No se pudo eliminar correctamente"));
        if (result.IsSuccess)
        {
            await Buscar();
        }
    }
}
