@page "/Libro/Edit/{LibroId:int}"

@inject LibrosService librosService
@inject PrestamosService prestamosService
@inject NavigationManager navigationManager
@inject ToastService toastService

<PageTitle>Modificar Libro</PageTitle>
<EditForm Model="Libro" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Modificar Libro</h5>
            </div>

            @* Título *@
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label"><strong>Título</strong></label>
                    <InputText class="form-control" @bind-Value="Libro.Titulo"></InputText>
                    <ValidationMessage For="(() => Libro.Titulo)" />
                </div>

                @* Autor *@
                <div class="mb-3">
                    <label class="form-label"><strong>Autor</strong></label>
                    <InputText class="form-control" @bind-Value="Libro.Autor"></InputText>
                    <ValidationMessage For="(() => Libro.Autor)" />
                </div>

                @* Año de Publicación *@
                <div class="mb-3">
                    <label class="form-label"><strong>Año de Publicación</strong></label>
                    <InputNumber class="form-control" @bind-Value="Libro.AnoPublicacion"></InputNumber>
                    <ValidationMessage For="(() => Libro.AnoPublicacion)" />
                </div>
            </div>

            @* Botones de Acción *@
            <div class="card-footer text-center mt-2">
                <a href="/Libro/Index" class="btn btn-secondary">
                    <span class="bi bi-arrow-left"></span> Volver
                </a>
                <button type="submit" class="btn btn-primary bi bi-floppy"> Modificar</button>
                <button type="button" class="btn btn-danger bi bi-trash" data-bs-toggle="modal" data-bs-target="#modalEliminarLibro"> Eliminar</button>
            </div>
        </div>
    </div>
</EditForm>

@* Modal de eliminación *@
<div class="modal fade" id="modalEliminarLibro" tabindex="-1" aria-labelledby="modalEliminarLibroLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="modalEliminarLibroLabel">Eliminar Libro</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        ¿Estás seguro de que deseas eliminar este libro?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="Eliminar">Sí, eliminar</button>
      </div>
    </div>
  </div>
</div>

@code {
    [Parameter]
    public int LibroId { get; set; }

    public Libros Libro { get; set; } = new Libros();

    protected override async Task OnInitializedAsync()
    {
        var result = await librosService.Buscar(LibroId);
        result.OnSuccess(libro => Libro = libro ?? new Libros());
    }

    public async Task Modificar()
    {
        Libro.Titulo = Libro.Titulo?.Trim();

        var tituloExisteResult = await librosService.GetList(l =>
            l.Titulo!.ToLower() == Libro.Titulo!.ToLower()
            && l.LibroId != Libro.LibroId);
        var tituloExiste = false;
        tituloExisteResult.OnSuccess(libros => tituloExiste = libros.Any());

        if (tituloExisteResult.IsFailure)
        {
            toastService.ShowError("No se pudo validar el título del libro.");
            return;
        }

        if (tituloExiste)
        {
            toastService.ShowError("Ya existe otro libro registrado con este título.");
            return;
        }

        var result = await librosService.Guardar(Libro);
        result.OnSuccess(() =>
        {
            toastService.ShowSuccess("Se ha modificado correctamente");
            navigationManager.NavigateTo("/Libro/Index");
        });
        result.OnFailure(() => toastService.ShowError("No se ha podido modificar"));
    }

    private async Task Eliminar()
    {
        var prestamosActivosResult = await prestamosService.GetList(p =>
            p.LibroId == LibroId && !p.Devuelto);
        var tienePrestamosActivos = false;
        prestamosActivosResult.OnSuccess(prestamos => tienePrestamosActivos = prestamos.Any());
        if (prestamosActivosResult.IsFailure)
        {
            toastService.ShowError("No se pudieron consultar los préstamos activos del libro.");
            return;
        }

        if (tienePrestamosActivos)
        {
            toastService.ShowError("No se puede eliminar el libro porque está prestado actualmente.");
            return;
        }

        var result = await librosService.Eliminar(LibroId);
        result.OnSuccess(() =>
        {
            toastService.ShowSuccess("Libro eliminado correctamente.");
            navigationManager.NavigateTo("/Libro/Index");
        });
        result.OnFailure(() => toastService.ShowError("No se pudo eliminar correctamente"));
    }
}
