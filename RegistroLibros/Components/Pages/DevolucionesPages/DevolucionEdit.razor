@page "/Devolucion/Edit/{DevolucionId:int}"

@inject DevolucionesService devolucionesService
@inject PrestamosService prestamosService
@inject NavigationManager navigationManager
@inject ToastService toastService

<PageTitle>Modificar Devolución</PageTitle>
<EditForm Model="Devolucion" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Modificar Devolución</h5>
            </div>

            <div class="card-body">
                
                @* Préstamo *@
                <div class="mb-3">
                    <label class="form-label"><strong>Préstamo</strong></label>
                    <InputSelect class="form-control form-select" @bind-Value="Devolucion.PrestamoId">
                        <option value="0" disabled>Elija un Préstamo</option>
                        @foreach (var prestamo in ListaPrestamos)
                        {
                            <option value="@prestamo.PrestamoId">#@prestamo.PrestamoId - @prestamo.Estudiante?.Nombres (@prestamo.Libro?.Titulo)</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="(() => Devolucion.PrestamoId)" />
                </div>

                @* Fecha de Devolución *@
                <div class="mb-3">
                    <label class="form-label"><strong>Fecha de Devolución</strong></label>
                    <InputDate class="form-control" @bind-Value="Devolucion.FechaDevolucion"></InputDate>
                    <ValidationMessage For="(() => Devolucion.FechaDevolucion)" />
                </div>

            </div>

            @* Botones de Acción *@
            <div class="card-footer text-center mt-2">
                <a href="/Devolucion/Index" class="btn btn-secondary">
                    <span class="bi bi-arrow-left"></span> Volver
                </a>
                <button type="submit" class="btn btn-primary bi bi-floppy"> Modificar</button>
                <button type="button" class="btn btn-danger bi bi-trash" data-bs-toggle="modal" data-bs-target="#modalEliminarDevolucion"> Eliminar</button>
            </div>
        </div>
    </div>
</EditForm>

@* Modal de eliminación *@
<div class="modal fade" id="modalEliminarDevolucion" tabindex="-1" aria-labelledby="modalEliminarDevolucionLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="modalEliminarDevolucionLabel">Eliminar Devolución</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                ¿Estás seguro de que deseas eliminar esta devolución?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="Eliminar">Sí, eliminar</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int DevolucionId { get; set; }

    public Devoluciones Devolucion { get; set; } = new Devoluciones();
    public List<Prestamos> ListaPrestamos { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        var result = await devolucionesService.Buscar(DevolucionId);
        result.OnSuccess(devolucion => Devolucion = devolucion ?? new Devoluciones());

        var prestamosResult = await prestamosService.GetList(p => !p.Devuelto || p.PrestamoId == Devolucion.PrestamoId);
        prestamosResult.OnSuccess(prestamos => ListaPrestamos = prestamos);
    }

    public async Task Modificar()
    {
        var result = await devolucionesService.Guardar(Devolucion);
        result.OnSuccess(() =>
        {
            toastService.ShowSuccess("Se ha modificado correctamente");
            navigationManager.NavigateTo("/Devolucion/Index");
        });
        result.OnFailure(() => toastService.ShowError("No se ha podido modificar"));
    }

    private async Task Eliminar()
    {
        var devolucionResult = await devolucionesService.Buscar(DevolucionId);
        Devoluciones? devolucion = null;
        devolucionResult.OnSuccess(resultado => devolucion = resultado);
        if (devolucionResult.IsFailure)
        {
            toastService.ShowError("No se pudo buscar la devolución.");
            return;
        }

        if (devolucion == null || devolucion.Prestamo == null)
        {
            toastService.ShowError("No se encontró el préstamo asociado a la devolución.");
            return;
        }

        var prestamo = devolucion.Prestamo;
        var otroPrestamoActivoResult = await prestamosService.GetList(p =>
            p.LibroId == prestamo.LibroId
            && !p.Devuelto
            && p.PrestamoId != devolucion.PrestamoId);
        var tieneOtroPrestamoActivo = false;
        otroPrestamoActivoResult.OnSuccess(prestamos => tieneOtroPrestamoActivo = prestamos.Any());
        if (otroPrestamoActivoResult.IsFailure)
        {
            toastService.ShowError("No se pudieron consultar los préstamos activos del libro.");
            return;
        }

        if (tieneOtroPrestamoActivo)
        {
            toastService.ShowError("No se puede eliminar la devolución porque el libro ya tiene otro préstamo activo.");
            return;
        }

        var result = await devolucionesService.Eliminar(DevolucionId);
        result.OnSuccess(() =>
        {
            toastService.ShowSuccess("Devolución eliminada correctamente.");
            navigationManager.NavigateTo("/Devolucion/Index");
        });
        result.OnFailure(() => toastService.ShowError("No se pudo eliminar correctamente"));
    }
}