@page "/Devolucion/Index"

@inject DevolucionesService devolucionesService
@inject PrestamosService prestamosService
@inject ToastService toastService

<PageTitle>Registro de Devoluciones</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-center mb-4">
            <h5 class="card-title">Registro de Devoluciones</h5>
            <a href="/Devolucion/Create" class="btn btn-primary"> <span class="bi bi-plus-square mt-3"></span> Crear</a>
        </div>
        
        @* Filtro *@
        <div class="card-body">
            <div class="row">
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por</strong></label>
                </div>
                <div class="col-4">
                    <label class="col-form-label"><strong>B&uacute;squeda</strong></label>
                </div>
            </div>

            @* Controles de Busqueda *@
            <div class="row align-items-center">
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opci&oacute;n</option>
                        <option value="Estudiante">Estudiante</option>
                        <option value="Libro">Libro</option>
                    </InputSelect>
                </div>
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>
            </div>

            @* Tabla *@
            <div class="grid">
                <QuickGrid Items="ListaDevoluciones.AsQueryable()" Class="table table-hover mt-3">
                    <PropertyColumn Property="@(d => d.DevolucionId)" Title="DevolucionId" Sortable="true" />
                    <PropertyColumn Property="@(d => d.PrestamoId)" Title="PrestamoId" Sortable="true" />
                    <PropertyColumn Property="@(d => d.Prestamo!.Estudiante!.Nombres)" Title="Estudiante" Sortable="true" />
                    <PropertyColumn Property="@(d => d.Prestamo!.Libro!.Titulo)" Title="Libro" Sortable="true" />
                    <PropertyColumn Property="@(d => d.FechaDevolucion)" Title="Fecha Devolución" Format="dd/MM/yyyy" Sortable="true" />
                    <TemplateColumn Title="Opciones" Align="Align.Center">
                        <div class="d-flex text-nowrap">
                            <a href="/Devolucion/Edit/@context.DevolucionId" class="btn btn-outline-primary bi bi-pencil-square"></a>
                            <button type="button" class="btn btn-outline-danger bi bi-trash ms-2" data-bs-toggle="modal" data-bs-target="#modalEliminarDevolucion" @onclick="() => devolucionIdAEliminar = context.DevolucionId"></button>
                        </div>
                    </TemplateColumn>
                </QuickGrid>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-between align-center mb-4">
            <label>Cantidad:  @ListaDevoluciones.Count()</label>
        </div>
    </div>
</div>

@* Modal de eliminación *@
<div class="modal fade" id="modalEliminarDevolucion" tabindex="-1" aria-labelledby="modalEliminarDevolucionLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="modalEliminarDevolucionLabel">Eliminar Devolución</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        ¿Estás seguro de que deseas eliminar esta devolución?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="Eliminar">Sí, eliminar</button>
      </div>
    </div>
  </div>
</div>

@code {
    public List<Devoluciones> ListaDevoluciones { get; set; } = new List<Devoluciones>();
    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var devolucionesResult = await devolucionesService.GetList(d => true);
        devolucionesResult.OnSuccess(devoluciones => ListaDevoluciones = devoluciones);
    }

    private async Task Buscar()
    {
        if (ValorFiltro.Trim() != "")
        {
            if (Filtro == "Estudiante")
            {
                var devolucionesResult = await devolucionesService.GetList(d => d.Prestamo!.Estudiante!.Nombres!.ToLower().Contains(ValorFiltro.ToLower()));
                devolucionesResult.OnSuccess(devoluciones => ListaDevoluciones = devoluciones);
            }
            else if (Filtro == "Libro")
            {
                var devolucionesResult = await devolucionesService.GetList(d => d.Prestamo!.Libro!.Titulo!.ToLower().Contains(ValorFiltro.ToLower()));
                devolucionesResult.OnSuccess(devoluciones => ListaDevoluciones = devoluciones);
            }
        }
        else
        {
            var devolucionesResult = await devolucionesService.GetList(d => true);
            devolucionesResult.OnSuccess(devoluciones => ListaDevoluciones = devoluciones);
        }
    }

    private int devolucionIdAEliminar;

    private async Task Eliminar()
    {
        var devolucionResult = await devolucionesService.Buscar(devolucionIdAEliminar);
        Devoluciones? devolucion = null;
        devolucionResult.OnSuccess(resultado => devolucion = resultado);
        if (devolucionResult.IsFailure)
        {
            toastService.ShowError("No se pudo buscar la devolución.");
            return;
        }

        if (devolucion == null || devolucion.Prestamo == null)
        {
            toastService.ShowError("No se encontró el préstamo asociado a la devolución.");
            return;
        }

        var prestamo = devolucion.Prestamo;
        var otroPrestamoActivoResult = await prestamosService.GetList(p =>
            p.LibroId == prestamo.LibroId
            && !p.Devuelto
            && p.PrestamoId != devolucion.PrestamoId);
        var tieneOtroPrestamoActivo = false;
        otroPrestamoActivoResult.OnSuccess(prestamos => tieneOtroPrestamoActivo = prestamos.Any());
        if (otroPrestamoActivoResult.IsFailure)
        {
            toastService.ShowError("No se pudieron consultar los préstamos activos del libro.");
            return;
        }

        if (tieneOtroPrestamoActivo)
        {
            toastService.ShowError("No se puede eliminar la devolución porque el libro ya tiene otro préstamo activo.");
            return;
        }

        var result = await devolucionesService.Eliminar(devolucionIdAEliminar);
        result.OnSuccess(() => toastService.ShowSuccess("Devolución eliminada correctamente."));
        result.OnFailure(() => toastService.ShowError("No se pudo eliminar correctamente"));
        if (result.IsSuccess)
        {
            await Buscar();
        }
    }
}
