@page "/Prestamo/Edit/{PrestamoId:int}"
@inject PrestamosService prestamosService
@inject EstudiantesServices estudiantesService
@inject LibrosServices librosService
@inject NavigationManager navigationManager

<PageTitle>Editar Préstamo</PageTitle>
<EditForm Model="Prestamo" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Editar Préstamo</h5>
            </div>

            <div class="card-body">
                
                @* Estudiante *@
                <div class="mb-3">
                    <label class="form-label"><strong>Estudiante</strong></label>
                    <InputSelect class="form-control form-select" @bind-Value="Prestamo.EstudianteId">
                        <option value="0" disabled>Elija un Estudiante</option>
                        @foreach (var estudiante in ListaEstudiantes)
                        {
                            <option value="@estudiante.EstudianteId">@estudiante.Nombres</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="(() => Prestamo.EstudianteId)" />
                </div>

                @* Libro *@
                <div class="mb-3">
                    <label class="form-label"><strong>Libro</strong></label>
                    <InputSelect class="form-control form-select" @bind-Value="Prestamo.LibroId">
                        <option value="0" disabled>Elija un Libro</option>
                        @foreach (var libro in ListaLibros)
                        {
                            <option value="@libro.LibroId">@libro.Titulo</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="(() => Prestamo.LibroId)" />
                </div>

                @* Fecha de Préstamo *@
                <div class="mb-3">
                    <label class="form-label"><strong>Fecha del Préstamo</strong></label>
                    <InputDate class="form-control" @bind-Value="Prestamo.FechaPrestamo"></InputDate>
                    <ValidationMessage For="(() => Prestamo.FechaPrestamo)" />
                </div>

                @* Fecha de Devolución *@
                <div class="mb-3">
                    <label class="form-label"><strong>Fecha de Devolución</strong></label>
                    <InputDate class="form-control" @bind-Value="Prestamo.FechaDevolucion"></InputDate>
                    <ValidationMessage For="(() => Prestamo.FechaDevolucion)" />
                </div>
                
            </div>

            @* Botones de Acción *@
            <div class="card-footer text-center mt-2">
                <a href="/Prestamo/Index" class="btn btn-secondary"> <span class="bi bi-arrow-left"></span> Volver</a>
                <button type="submit" class="btn btn-primary bi bi-floppy"> Modificar</button>
                <button type="button" class="btn btn-danger bi bi-trash" @onclick="OnShowModalClick"> Eliminar</button>
            </div>
        </div>
    </div>
</EditForm>

<Modal @ref="modal" Title="Eliminar Préstamo">
    <BodyTemplate>
        ¿Estás seguro de que quieres eliminar este préstamo?
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="OnHideModalClick">Cancelar</Button>
        <Button Color="ButtonColor.Danger" @onclick="Eliminar">Sí, eliminar</Button>
    </FooterTemplate>
</Modal>

@code {
    [Parameter]
    public int PrestamoId { get; set; }
    public Prestamos Prestamo { get; set; } = new Prestamos();
    public List<Estudiantes> ListaEstudiantes { get; set; } = new List<Estudiantes>();
    public List<Libros> ListaLibros { get; set; } = new List<Libros>();

    protected override async Task OnInitializedAsync()
    {
        ListaEstudiantes = await estudiantesService.GetList(e => e.EstudianteId > 0);
        ListaLibros = await librosService.GetList(l => l.LibroId > 0);
        
        var prestamoEncontrado = await prestamosService.Buscar(PrestamoId);
        if (prestamoEncontrado != null)
        {
            Prestamo = prestamoEncontrado;
        }
    }

    public async Task Guardar()
    {
        if (Prestamo.FechaDevolucion < Prestamo.FechaPrestamo)
        {
            toastService.ShowError("La fecha de devolución no puede ser menor a la fecha de préstamo.");
            return;
        }

        var estudiantePrestamos = await prestamosService.GetList(p => p.EstudianteId == Prestamo.EstudianteId && !p.Devuelto && p.PrestamoId != Prestamo.PrestamoId);
        if (estudiantePrestamos.Any())
        {
            toastService.ShowError("Este estudiante ya tiene otro préstamo activo.");
            return;
        }

        var libroPrestamos = await prestamosService.GetList(p => p.LibroId == Prestamo.LibroId && !p.Devuelto && p.PrestamoId != Prestamo.PrestamoId);
        if (libroPrestamos.Any())
        {
            toastService.ShowError("Este libro ya está prestado a otra persona.");
            return;
        }

        var modificado = await prestamosService.Guardar(Prestamo);
        if (modificado)
        {
            toastService.ShowSuccess("Préstamo modificado correctamente.");
            navigationManager.NavigateTo("/Prestamo/Index");
        }
        else
        {
            toastService.ShowError("No se pudo modificar el préstamo.");
        }
    }

    private Modal modal = default!;

    private async Task OnShowModalClick()
    {
        await modal.ShowAsync();
    }

    private async Task OnHideModalClick()
    {
        await modal.HideAsync();
    }

    private async Task Eliminar()
    {
        var eliminado = await prestamosService.Eliminar(PrestamoId);
        if (eliminado)
        {
            toastService.ShowSuccess("Préstamo eliminado correctamente.");
            navigationManager.NavigateTo("/Prestamo/Index");
        }
        else
        {
            toastService.ShowError("No se pudo eliminar el préstamo.");
        }
        await modal.HideAsync();
    }
}
