@page "/Prestamo/Edit/{PrestamoId:int}"

@inject PrestamosService prestamosService
@inject EstudiantesService estudiantesService
@inject LibrosService librosService
@inject NavigationManager navigationManager
@inject ToastService toastService

<PageTitle>Editar Préstamo</PageTitle>
<EditForm Model="Prestamo" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Editar Préstamo</h5>
            </div>

            <div class="card-body">
                
                @* Estudiante *@
                <div class="mb-3">
                    <label class="form-label"><strong>Estudiante</strong></label>
                    <InputSelect class="form-control form-select" @bind-Value="Prestamo.EstudianteId">
                        <option value="0" disabled>Elija un Estudiante</option>
                        @foreach (var estudiante in ListaEstudiantes)
                        {
                            <option value="@estudiante.EstudianteId">@estudiante.Nombres</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="(() => Prestamo.EstudianteId)" />
                </div>

                @* Libro *@
                <div class="mb-3">
                    <label class="form-label"><strong>Libro</strong></label>
                    <InputSelect class="form-control form-select" @bind-Value="Prestamo.LibroId">
                        <option value="0" disabled>Elija un Libro</option>
                        @foreach (var libro in ListaLibros)
                        {
                            <option value="@libro.LibroId">@libro.Titulo</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="(() => Prestamo.LibroId)" />
                </div>

                @* Fecha de Préstamo *@
                <div class="mb-3">
                    <label class="form-label"><strong>Fecha del Préstamo</strong></label>
                    <InputDate class="form-control" @bind-Value="Prestamo.FechaPrestamo"></InputDate>
                    <ValidationMessage For="(() => Prestamo.FechaPrestamo)" />
                </div>
            </div>

            @* Botones de Acción *@
            <div class="card-footer text-center mt-2">
                <a href="/Prestamo/Index" class="btn btn-secondary"> <span class="bi bi-arrow-left"></span> Volver</a>
                <button type="submit" class="btn btn-primary bi bi-floppy"> Modificar</button>
                <button type="button" class="btn btn-danger bi bi-trash" data-bs-toggle="modal" data-bs-target="#modalEliminarPrestamo"> Eliminar</button>
            </div>
        </div>
    </div>
</EditForm>

@* Modal de eliminación *@
<div class="modal fade" id="modalEliminarPrestamo" tabindex="-1" aria-labelledby="modalEliminarPrestamoLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="modalEliminarPrestamoLabel">Eliminar Préstamo</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        ¿Estás seguro de que deseas eliminar este préstamo?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="Eliminar">Sí, eliminar</button>
      </div>
    </div>
  </div>
</div>

@code {
    [Parameter]
    public int PrestamoId { get; set; }
    public Prestamos Prestamo { get; set; } = new Prestamos();
    public List<Estudiantes> ListaEstudiantes { get; set; } = new List<Estudiantes>();
    public List<Libros> ListaLibros { get; set; } = new List<Libros>();

    protected override async Task OnInitializedAsync()
    {
        var estudiantesResult = await estudiantesService.GetList(e => true);
        estudiantesResult.OnSuccess(estudiantes => ListaEstudiantes = estudiantes);

        var librosResult = await librosService.GetList(l => true);
        librosResult.OnSuccess(libros => ListaLibros = libros);

        var result = await prestamosService.Buscar(PrestamoId);
        result.OnSuccess(prestamo => Prestamo = prestamo ?? new Prestamos());
    }

    public async Task Guardar()
    {
        var estudiantePrestamosResult = await prestamosService.GetList(p => p.EstudianteId == Prestamo.EstudianteId && !p.Devuelto && p.PrestamoId != Prestamo.PrestamoId);
        var estudianteTienePrestamoActivo = false;
        estudiantePrestamosResult.OnSuccess(prestamos => estudianteTienePrestamoActivo = prestamos.Any());
        if (estudiantePrestamosResult.IsFailure)
        {
            toastService.ShowError("No se pudieron validar los préstamos del estudiante.");
            return;
        }

        if (estudianteTienePrestamoActivo)
        {
            toastService.ShowError("Este estudiante ya tiene otro préstamo activo.");
            return;
        }

        var libroPrestamosResult = await prestamosService.GetList(p => p.LibroId == Prestamo.LibroId && !p.Devuelto && p.PrestamoId != Prestamo.PrestamoId);
        var libroEstaPrestado = false;
        libroPrestamosResult.OnSuccess(prestamos => libroEstaPrestado = prestamos.Any());
        if (libroPrestamosResult.IsFailure)
        {
            toastService.ShowError("No se pudieron validar los préstamos del libro.");
            return;
        }

        if (libroEstaPrestado)
        {
            toastService.ShowError("Este libro ya está prestado a otra persona.");
            return;
        }

        var result = await prestamosService.Guardar(Prestamo);
        result.OnSuccess(() =>
        {
            toastService.ShowSuccess("Se ha modificado correctamente");
            navigationManager.NavigateTo("/Prestamo/Index");
        });
        result.OnFailure(() => toastService.ShowError("No se ha podido modificar"));
    }

    private async Task Eliminar()
    {
        var result = await prestamosService.Eliminar(Prestamo.PrestamoId);
        result.OnSuccess(() =>
        {
            toastService.ShowSuccess("Se ha eliminado correctamente");
            navigationManager.NavigateTo("/Prestamo/Index");
        });
        result.OnFailure(() => toastService.ShowError("No se ha podido eliminar correctamente"));
    }
}
