@page "/Prestamo/Index"
@page "/"
@inject PrestamosService prestamosService

<PageTitle>Registro de Préstamos</PageTitle>

<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-center mb-4">
            <h5 class="card-title">Registro de Préstamos</h5>
            <a href="/Prestamo/Create" class="btn btn-primary"> <span class="bi bi-plus-square mt-3"></span> Crear</a>
        </div>
        
        @* Filtro *@
        <div class="card-body">
            <div class="row">
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por</strong></label>
                </div>
                <div class="col-4">
                    <label class="col-form-label"><strong>B&uacute;squeda</strong></label>
                </div>
            </div>

            @* Controles de Busqueda *@
            <div class="row align-items-center">
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opci&oacute;n</option>
                        <option value="Estudiante">Estudiante</option>
                        <option value="Libro">Libro</option>
                    </InputSelect>
                </div>
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>
            </div>

            @* Tabla *@
            <QuickGrid Items="ListaPrestamos.AsQueryable()" Class="table table-hover mt-3">
                <PropertyColumn Property="@(p => p.PrestamoId)" Title="PrestamoId" Sortable="true" />
                <PropertyColumn Property="@(p => p.Estudiante!.Nombres)" Title="Estudiante" Sortable="true" />
                <PropertyColumn Property="@(p => p.Libro!.Titulo)" Title="Libro" Sortable="true" />
                <PropertyColumn Property="@(p => p.FechaPrestamo)" Title="Fecha Préstamo" Format="dd/MM/yyyy" Sortable="true" />
                <PropertyColumn Property="@(p => p.FechaDevolucion)" Title="Fecha Devolución" Format="dd/MM/yyyy" Sortable="true" />
                <TemplateColumn Title="Devuelto" Sortable="true">
                    @(context.Devuelto ? "Sí" : "No")
                </TemplateColumn>
                <TemplateColumn Title="Opciones" Align="Align.Center">
                    <div class="d-flex text-nowrap">
                        <a href="/Prestamo/Edit/@context.PrestamoId" class="btn btn-outline-primary bi bi-pencil-square"></a>
                        <button type="button" class="btn btn-outline-danger bi bi-trash ms-2" @onclick="() => OnShowModalClick(context.PrestamoId)"></button>
                    </div>
                </TemplateColumn>
            </QuickGrid>
        </div>
        <div class="card-footer d-flex justify-content-between align-center mb-4">
            <label>Cantidad:  @ListaPrestamos.Count()</label>
        </div>
    </div>
</div>

<Modal @ref="modal" Title="Eliminar Préstamo">
    <BodyTemplate>
        ¿Estás seguro de que quieres eliminar este préstamo?
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="OnHideModalClick">Cancelar</Button>
        <Button Color="ButtonColor.Danger" @onclick="Eliminar">Sí, eliminar</Button>
    </FooterTemplate>
</Modal>

@code {
    public List<Prestamos> ListaPrestamos { get; set; } = new List<Prestamos>();
    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        ListaPrestamos = await prestamosService.GetList(p => p.PrestamoId > 0);
    }

    private async Task Buscar()
    {
        if (ValorFiltro.Trim() != "")
        {
            if (Filtro == "Estudiante")
            {
                ListaPrestamos = await prestamosService.GetList(p => p.Estudiante!.Nombres!.ToLower().Contains(ValorFiltro.ToLower()));
            }
            else if (Filtro == "Libro")
            {
                ListaPrestamos = await prestamosService.GetList(p => p.Libro!.Titulo!.ToLower().Contains(ValorFiltro.ToLower()));
            }
        }
        else
            ListaPrestamos = await prestamosService.GetList(p => p.PrestamoId > 0);
    }

    private Modal modal = default!;
    private int prestamoIdAEliminar;

    private async Task OnShowModalClick(int id)
    {
        prestamoIdAEliminar = id;
        await modal.ShowAsync();
    }

    private async Task OnHideModalClick()
    {
        await modal.HideAsync();
    }

    private async Task Eliminar()
    {
        var eliminado = await prestamosService.Eliminar(prestamoIdAEliminar);
        if (eliminado)
        {
            toastService.ShowSuccess("Préstamo eliminado correctamente.");
            await Buscar(); // Recargar la tabla
        }
        else
        {
            toastService.ShowError("No se pudo eliminar el préstamo.");
        }
        await modal.HideAsync();
    }
}
