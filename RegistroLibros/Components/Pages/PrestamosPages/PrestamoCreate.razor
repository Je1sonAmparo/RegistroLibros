@page "/Prestamo/Create"

@inject PrestamosService prestamosService
@inject EstudiantesService estudiantesService
@inject LibrosService librosService
@inject NavigationManager navigationManager
@inject ToastService toastService

<PageTitle>Crear Préstamo</PageTitle>
<EditForm Model="Prestamo" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Crear Préstamo</h5>
            </div>

            <div class="card-body">
                
                @* Estudiante *@
                <div class="mb-3">
                    <label class="form-label"><strong>Estudiante</strong></label>
                    <InputSelect class="form-control form-select" @bind-Value="Prestamo.EstudianteId">
                        <option value="0" selected disabled>Elija un Estudiante</option>
                        @foreach (var estudiante in ListaEstudiantes)
                        {
                            <option value="@estudiante.EstudianteId">@estudiante.Nombres</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="(() => Prestamo.EstudianteId)" />
                </div>

                @* Libro *@
                <div class="mb-3">
                    <label class="form-label"><strong>Libro</strong></label>
                    <InputSelect class="form-control form-select" @bind-Value="Prestamo.LibroId">
                        <option value="0" selected disabled>Elija un Libro</option>
                        @foreach (var libro in ListaLibros)
                        {
                            <option value="@libro.LibroId">@libro.Titulo</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="(() => Prestamo.LibroId)" />
                </div>

                @* Fecha de Préstamo *@
                <div class="mb-3">
                    <label class="form-label"><strong>Fecha del Préstamo</strong></label>
                    <InputDate class="form-control" @bind-Value="Prestamo.FechaPrestamo"></InputDate>
                    <ValidationMessage For="(() => Prestamo.FechaPrestamo)" />
                </div>

            </div>

            @* Botones de Acción *@
            <div class="card-footer text-center mt-2">
                <a href="/Prestamo/Index" class="btn btn-secondary"> <span class="bi bi-arrow-left"></span> Volver</a>
                <button type="submit" class="btn btn-primary bi bi-floppy"> Guardar</button>
            </div>
        </div>
    </div>
</EditForm>

@code {
    public Prestamos Prestamo { get; set; } = new Prestamos();
    public List<Estudiantes> ListaEstudiantes { get; set; } = new List<Estudiantes>();
    public List<Libros> ListaLibros { get; set; } = new List<Libros>();

    protected override async Task OnInitializedAsync()
    {
        var estudiantesResult = await estudiantesService.GetList(e => true);
        estudiantesResult.OnSuccess(estudiantes => ListaEstudiantes = estudiantes);

        var librosResult = await librosService.GetList(l => true);
        librosResult.OnSuccess(libros => ListaLibros = libros);
    }

    public async Task Guardar()
    {
        var estudiantePrestamosResult = await prestamosService.GetList(p => p.EstudianteId == Prestamo.EstudianteId && !p.Devuelto);
        var tienePrestamoActivo = false;
        estudiantePrestamosResult.OnSuccess(prestamos => tienePrestamoActivo = prestamos.Any());
        if (estudiantePrestamosResult.IsFailure)
        {
            toastService.ShowError("No se pudieron validar los préstamos del estudiante.");
            return;
        }

        if (tienePrestamoActivo)
        {
            toastService.ShowError("Este estudiante ya tiene un préstamo activo.");
            return;
        }

        var libroPrestamosResult = await prestamosService.GetList(p => p.LibroId == Prestamo.LibroId && !p.Devuelto);
        var libroPrestado = false;
        libroPrestamosResult.OnSuccess(prestamos => libroPrestado = prestamos.Any());
        if (libroPrestamosResult.IsFailure)
        {
            toastService.ShowError("No se pudieron validar los préstamos del libro.");
            return;
        }

        if (libroPrestado)
        {
            toastService.ShowError("Este libro ya está prestado.");
            return;
        }

        var creadoResult = await prestamosService.Guardar(Prestamo);
        creadoResult.OnSuccess(() =>
        {
            toastService.ShowSuccess("Préstamo guardado correctamente.");
            navigationManager.NavigateTo("/Prestamo/Index");
        });
        creadoResult.OnFailure(() => toastService.ShowError("No se pudo guardar el préstamo."));
    }
}
