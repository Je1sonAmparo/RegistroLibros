@page "/Prestamo/Delete/{PrestamoId:int}"
@inject PrestamosService prestamosService
@inject NavigationManager navigationManager

<PageTitle>Eliminar Préstamo</PageTitle>

<div class="container">
    <div class="card shadow-lg">
        <div class="card-header text-center">
            <h5 class="card-title">¿Estás seguro de eliminar este Préstamo?</h5>
        </div>

        <div class="card-body">
            @if (Prestamo != null)
            {
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><strong>Estudiante:</strong></label>
                        <span>@(Prestamo.Estudiante?.Nombres)</span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><strong>Libro:</strong></label>
                        <span>@(Prestamo.Libro?.Titulo)</span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><strong>Fecha de Préstamo:</strong></label>
                        <span>@Prestamo.FechaPrestamo.ToShortDateString()</span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label"><strong>Fecha de Devolución:</strong></label>
                        <span>@Prestamo.FechaDevolucion.ToShortDateString()</span>
                    </div>
                </div>
            }
            else
            {
                <p>Cargando información del préstamo...</p>
            }
        </div>

        @* Botones de Acción *@
        <div class="card-footer text-center mt-2">
            <a href="/Prestamo/Index" class="btn btn-secondary"> <span class="bi bi-arrow-left"></span> Volver</a>
            <button type="button" class="btn btn-danger bi bi-trash" @onclick="Eliminar"> Eliminar</button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int PrestamoId { get; set; }
    public Prestamos Prestamo { get; set; } = new Prestamos();

    protected override async Task OnInitializedAsync()
    {
        var prestamoEncontrado = await prestamosService.Buscar(PrestamoId);
        if (prestamoEncontrado != null)
        {
            Prestamo = prestamoEncontrado;
        }
    }

    public async Task Eliminar()
    {
        var eliminado = await prestamosService.Eliminar(PrestamoId);
        if (eliminado)
        {
            toastService.ShowSuccess("Préstamo eliminado correctamente.");
            navigationManager.NavigateTo("/Prestamo/Index");
        }
        else
        {
            toastService.ShowError("No se pudo eliminar el préstamo.");
        }
    }
}
